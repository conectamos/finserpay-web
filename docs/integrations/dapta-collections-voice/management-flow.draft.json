{
  "type": "api",
  "name": "Registrar gestión de cobranza — Valeria",
  "engine": "v1",
  "api_nodes": [
    {
      "id": "trgId",
      "type": "trigger",
      "name": "Trigger",
      "api_trigger": {
        "trigger_options": "http",
        "trigger_type": "post",
        "trigger_params": [
          {
            "id": "pm000",
            "origin": "body",
            "key": "event_id",
            "type": "text",
            "required": true
          },
          {
            "id": "pm001",
            "origin": "body",
            "key": "result",
            "type": "text",
            "required": true
          },
          {
            "id": "pm002",
            "origin": "body",
            "key": "comment",
            "type": "text",
            "required": true
          },
          {
            "id": "pm003",
            "origin": "body",
            "key": "next_follow_up_at",
            "type": "text",
            "required": true
          }
        ]
      },
      "childRef": "nrmId"
    },
    {
      "id": "nrmId",
      "type": "action",
      "name": "Normalizar identidad",
      "parentRefs": [
        "trgId"
      ],
      "childRef": "qryId",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const body = params.trigger.body;\nconst isRecord = value => value !== null && typeof value === 'object' && !Array.isArray(value);\nconst owns = (value,key) => Object.prototype.hasOwnProperty.call(value,key);\nif (!isRecord(body)) throw new Error('Gestion invalida');\nconst keys = ['event_id','result','comment','next_follow_up_at'];\nconst hasArgs = owns(body,'args');\nif (hasArgs && (!isRecord(body.args) || keys.some(key=>owns(body,key)))) throw new Error('Gestion invalida');\nconst data = hasArgs ? body.args : body;\nconst required = (value,max) => { if (typeof value !== 'string' || !value.trim() || value.length > max || /[\\u0000-\\u001f\\u007f]/.test(value)) throw new Error('Gestion invalida'); return value.trim(); };\nconst event_id = required(data.event_id,36), result = required(data.result,30), comment = required(data.comment,1500), next_follow_up_at = required(data.next_follow_up_at,35);\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(event_id) || !['MEDIOS_PAGO','PAGO_REALIZADO'].includes(result)) throw new Error('Gestion invalida');\nmodule.exports = {request_body:JSON.stringify({event_id,result,comment,next_follow_up_at})};"
        },
        "response": [
          {
            "variable_name": "request_body",
            "response_value_path": "request_body"
          }
        ]
      }
    },
    {
      "id": "qryId",
      "type": "action",
      "name": "Verificar identidad",
      "parentRefs": [
        "nrmId"
      ],
      "childRef": "chkId",
      "api_action": {
        "action_type": "api",
        "on_error": "continue",
        "external_api_action": {
          "request_type": "post",
          "url": "https://finserpay.com/api/integraciones/cobranza/voz/gestion",
          "body_format": "raw",
          "body": "{{normalizar_identidad.request_body}}",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer NEW_PRIVATE_COLLECTIONS_FLOW_TOKEN"
            }
          ],
          "authorization": {
            "type": "",
            "token": ""
          }
        },
        "response": [
          {
            "variable_name": "ok",
            "response_value_path": "response.ok"
          },
          {
            "variable_name": "registrado",
            "response_value_path": "response.registrado"
          },
          {
            "variable_name": "enviado",
            "response_value_path": "response.enviado"
          },
          {
            "variable_name": "code",
            "response_value_path": "response.code"
          }
        ]
      }
    },
    {
      "id": "chkId",
      "type": "action",
      "name": "Preparar respuesta identidad",
      "parentRefs": [
        "qryId"
      ],
      "childRef": "rspId",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const result = params.verificar_identidad || {};\nconst registrado = result.ok === true && result.registrado === true;\nmodule.exports = {ok:registrado,registrado,enviado:registrado && result.enviado === true,code:registrado ? null : 'MANAGEMENT_UNAVAILABLE'};"
        },
        "response": [
          {
            "variable_name": "ok",
            "response_value_path": "ok"
          },
          {
            "variable_name": "registrado",
            "response_value_path": "registrado"
          },
          {
            "variable_name": "enviado",
            "response_value_path": "enviado"
          },
          {
            "variable_name": "code",
            "response_value_path": "code"
          }
        ]
      }
    },
    {
      "id": "rspId",
      "type": "response",
      "name": "Respuesta identidad",
      "parentRefs": [
        "chkId"
      ],
      "api_response": {
        "response_params": [
          {
            "key": "ok",
            "value": "{{preparar_respuesta_identidad.ok}}"
          },
          {
            "key": "registrado",
            "value": "{{preparar_respuesta_identidad.registrado}}"
          },
          {
            "key": "enviado",
            "value": "{{preparar_respuesta_identidad.enviado}}"
          },
          {
            "key": "code",
            "value": "{{preparar_respuesta_identidad.code}}"
          }
        ]
      }
    }
  ],
  "note_nodes": []
}
