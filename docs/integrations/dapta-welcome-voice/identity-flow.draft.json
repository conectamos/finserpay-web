{
  "type": "api",
  "name": "Verificar identidad — Bienvenida de voz",
  "engine": "v1",
  "api_nodes": [
    {
      "id": "trgId",
      "type": "trigger",
      "name": "Trigger",
      "api_trigger": {
        "trigger_options": "http",
        "trigger_type": "post",
        "trigger_params": [
          {
            "id": "pm000",
            "origin": "body",
            "key": "event_token",
            "type": "text",
            "required": true
          },
          {
            "id": "pm001",
            "origin": "body",
            "key": "customer_name",
            "type": "text",
            "required": true
          },
          {
            "id": "pm002",
            "origin": "body",
            "key": "customer_document",
            "type": "text",
            "required": true
          }
        ]
      },
      "childRef": "nrmId"
    },
    {
      "id": "nrmId",
      "type": "action",
      "name": "Normalizar identidad",
      "parentRefs": [
        "trgId"
      ],
      "childRef": "qryId",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const data = params.trigger.body || {};\nconst required = (value, limit) => {\n  if (typeof value !== 'string' || !value.trim() || value.length > limit || /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]/.test(value)) throw new Error('Solicitud de identidad invalida');\n  return value.trim();\n};\nconst event_token = required(data.event_token, 1000);\nconst customer_name = required(data.customer_name, 240);\nconst customer_document = required(data.customer_document, 80);\nconst request_body = JSON.stringify({ event_token, customer_name, customer_document });\nmodule.exports = { request_body };"
        },
        "response": [
          {
            "variable_name": "request_body",
            "response_value_path": "request_body"
          }
        ]
      }
    },
    {
      "id": "qryId",
      "type": "action",
      "name": "Verificar identidad",
      "parentRefs": [
        "nrmId"
      ],
      "childRef": "chkId",
      "api_action": {
        "action_type": "api",
        "on_error": "continue",
        "external_api_action": {
          "request_type": "post",
          "url": "https://finserpay.com/api/integraciones/dapta/bienvenida-voz/identidad",
          "body_format": "raw",
          "body": "{{normalizar_identidad.request_body}}",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "authorization": {
            "type": "",
            "token": ""
          }
        },
        "response": [
          {
            "variable_name": "ok",
            "response_value_path": "response.ok"
          },
          {
            "variable_name": "verificado",
            "response_value_path": "response.verificado"
          },
          {
            "variable_name": "condiciones",
            "response_value_path": "response.condiciones"
          }
        ]
      }
    },
    {
      "id": "chkId",
      "type": "action",
      "name": "Preparar respuesta identidad",
      "parentRefs": [
        "qryId"
      ],
      "childRef": "rspId",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const result = params.verificar_identidad || {};\nconst ok = result.ok === true;\nconst verificado = ok && result.verificado === true;\nconst hasConditions = Boolean(result.condiciones && typeof result.condiciones === 'object' && !Array.isArray(result.condiciones));\nconst complete = !verificado || hasConditions;\nmodule.exports = {\n  ok: ok && complete,\n  verificado: verificado && Boolean(hasConditions),\n  condiciones: verificado && hasConditions ? result.condiciones : null,\n  code: ok && complete ? null : 'IDENTITY_UNAVAILABLE'\n};"
        },
        "response": [
          {
            "variable_name": "ok",
            "response_value_path": "ok"
          },
          {
            "variable_name": "verificado",
            "response_value_path": "verificado"
          },
          {
            "variable_name": "condiciones",
            "response_value_path": "condiciones"
          },
          {
            "variable_name": "code",
            "response_value_path": "code"
          }
        ]
      }
    },
    {
      "id": "rspId",
      "type": "response",
      "name": "Respuesta identidad",
      "parentRefs": [
        "chkId"
      ],
      "api_response": {
        "response_params": [
          {
            "key": "ok",
            "value": "{{preparar_respuesta_identidad.ok}}"
          },
          {
            "key": "verificado",
            "value": "{{preparar_respuesta_identidad.verificado}}"
          },
          {
            "key": "condiciones",
            "value": "{{preparar_respuesta_identidad.condiciones}}"
          },
          {
            "key": "code",
            "value": "{{preparar_respuesta_identidad.code}}"
          }
        ]
      }
    }
  ],
  "note_nodes": []
}
