        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const data = params.trigger.body || {};\nconst required = (value, limit) => {\n  if (typeof value !== 'string' || !value.trim() || value.length > limit || /[\\u0000-\\u001f\\u007f]/.test(value)) throw new Error('Solicitud de llamada invalida');\n  return value.trim();\n};\nconst event_id = required(data.event_id, 36);\nconst credito_id = required(data.credito_id, 16);\nconst event_token = required(data.event_token, 1000);\nconst to_number = required(data.to_number, 16);\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(event_id) || !/^[1-9]\\d*$/.test(credito_id) || !/^\\+573\\d{9}$/.test(to_number)) throw new Error('Solicitud de llamada invalida');\nmodule.exports = { event_id, credito_id, event_token, to_number };"
        },
        "response": [
