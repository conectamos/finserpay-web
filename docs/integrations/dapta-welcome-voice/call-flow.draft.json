    {
      "id": "chkCl",
      "type": "action",
      "name": "Confirmar recepcion",
      "parentRefs": [
        "natCl"
      ],
      "childRef": "rspCl",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const native = params.llamada_bienvenida || {};\nconst hasError = (value) => value !== undefined && value !== null && value !== '' && value !== false && (typeof value !== 'object' || Object.keys(value).length > 0);\nconst parseContainer = (value) => {\n  if (typeof value !== 'string') return value;\n  try { return JSON.parse(value); } catch { return value; }\n};\nconst executionFailed = (value, depth = 0) => {\n  const parsed = parseContainer(value);\n  if (!parsed || typeof parsed !== 'object') return false;\n  if (depth > 12) return true;\n  if (Array.isArray(parsed)) return parsed.some((child) => executionFailed(child, depth + 1));\n  if (hasError(parsed.error) || hasError(parsed.errors) || hasError(parsed.node_errors) || parsed.ok === false || parsed.success === false || [parsed.call_status, parsed.status].some((status) => ['error', 'failed', 'rejected', 'cancelled', 'canceled'].includes(String(status || '').toLowerCase()))) return true;\n  return Object.values(parsed).some((child) => executionFailed(child, depth + 1));\n};\nlet current = native.response;\nconst failed = executionFailed(native);\nlet call_id = null;\nfor (let depth = 0; !failed && depth < 4; depth++) {\n  current = parseContainer(current);\n  if (!current || typeof current !== 'object' || Array.isArray(current)) break;\n  if (typeof current.call_id === 'string' && /^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$/.test(current.call_id)) { call_id = current.call_id; break; }\n  current = current.response ?? current.result ?? current.data;\n}\nmodule.exports = { ok: !failed && Boolean(call_id), call_id: !failed ? call_id : null, code: failed ? 'NATIVE_CALL_ERROR' : call_id ? null : 'NATIVE_CALL_UNKNOWN' };"
        },
        "response": [
