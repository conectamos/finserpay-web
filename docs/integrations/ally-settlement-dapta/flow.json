        "action_type": "code",
        "code_action": {
          "code": "const context=params.validar_autorizacion;\nconst parsed=value=>{if(typeof value!=='string'||value.length>65536||!/^[\\s]*[\\[{]/.test(value))return value;try{return JSON.parse(value);}catch{return value;}};\nlet count=0,rejected=false;const seen=new Set(),receipts=new Set();\nconst populated=x=>x!==undefined&&x!==null&&x!==false&&x!==''&&!(Array.isArray(x)&&x.length===0);\nconst visit=(original,depth)=>{\n  if(depth>8||count++>200){rejected=true;return;}\n  const v=parsed(original);if(!v||typeof v!=='object'||seen.has(v))return;seen.add(v);\n  if(v.ok===false||v.success===false||v.suppressed===true||v.scheduled===true||populated(v.error)||populated(v.errors)||['failed','error','rejected','suppressed','scheduled'].includes(String(v.status||'').toLowerCase()))rejected=true;\n  if(v.success===true&&v.status==='sent'&&v.suppressed===false&&v.scheduled!==true&&typeof v.provider_message_id==='string'&&/^wamid\\.[A-Za-z0-9+/=_-]{5,512}$/.test(v.provider_message_id))receipts.add(v.provider_message_id);\n  for(const child of Object.values(v))if(child&&(typeof child==='object'||typeof child==='string'))visit(child,depth+1);\n};\nvisit(params.enviar_liquidacion,0);\nconst accepted=!rejected&&receipts.size===1;\nconst provider_message_id=accepted?[...receipts][0]:null;\nconst code=accepted?null:'PROVIDER_RECEIPT_UNCONFIRMED';\nconst base={event_id:context.event_id,recipient:context.recipient,sender:'573124085562',provider_message_id,code};\nconst receipt_body=JSON.stringify({action:'receipt',...base,status:accepted?'accepted':'uncertain',timestamp:new Date().toISOString()});\nmodule.exports={...base,ok:accepted,accepted,receipt_body};"
        }
      },
