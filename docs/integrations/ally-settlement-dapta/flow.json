        "action_type": "code",
        "code_action": {
          "code": "const expected=params.normalizar_evento;\nconst parsed=value=>{if(typeof value!=='string'||value.length>32768)return value;try{return JSON.parse(value);}catch{return value;}};\nlet root=parsed(params.autorizar_envio?.response);\nfor(let i=0;i<4&&root&&typeof root==='object'&&root.ok===undefined;i++)root=parsed(root.response??root.body??root.data);\nconst plain=value=>value&&typeof value==='object'&&!Array.isArray(value);\nif(!plain(root)||root.ok!==true||root.authorized!==true){\n  module.exports={authorized:'no',event_id:expected.event_id,recipient:expected.recipient};\n}else{\n  const fields=['ally_name','period_start','period_end','net_amount','pdf_url','filename'];\n  if(root.event_id!==expected.event_id||root.recipient!==expected.recipient||root.sender!=='573124085562'||\n    fields.some(k=>typeof root[k]!=='string'||!root[k].trim()||root[k].length>(k==='pdf_url'?4096:300)||/[\\u0000-\\u001f\\u007f]/.test(root[k]))||\n    !/^https:\\/\\/finserpay\\.com\\/api\\/integraciones\\/liquidaciones\\/documento\\?/.test(root.pdf_url))throw new Error('Autorizacion inconsistente');\n  module.exports={authorized:'yes',event_id:root.event_id,recipient:root.recipient,sender:root.sender,ally_name:root.ally_name,period_start:root.period_start,period_end:root.period_end,net_amount:root.net_amount,pdf_url:root.pdf_url,filename:root.filename};\n}"
