        "action_type": "code",
        "code_action": {
          "code": "const b=params.trigger?.body;\nif(!b||typeof b!=='object'||Array.isArray(b))throw new Error('Solicitud no valida');\nif(typeof b.event_id!=='string'||!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(b.event_id))throw new Error('Evento no valido');\nif(typeof b.recipient!=='string'||!/^[1-9]\\d{7,14}$/.test(b.recipient))throw new Error('Destino no valido');\nif(typeof b.callback_token!=='string'||!/^v1\\.\\d{10}\\.[0-9a-f]{64}$/.test(b.callback_token))throw new Error('Autorizacion no valida');\nconst event_id=b.event_id.toLowerCase();\nmodule.exports={event_id,recipient:b.recipient,callback_token:b.callback_token,claim_body:JSON.stringify({action:'claim',event_id,recipient:b.recipient})};"
        }
