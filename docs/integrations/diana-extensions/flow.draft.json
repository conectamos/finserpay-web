    {
      "id": "nrmPr",
      "name": "Normalizar Prorroga",
      "type": "action",
      "api_action": {
        "on_error": "stop",
        "response": [
          {
            "variable_name": "request_body",
            "response_value_path": "request_body"
          }
        ],
        "action_type": "code",
        "code_action": {
          "code": "// Flow Studio Code node. No credential or customer data is logged.\nconst body = params.trigger.body;\nconst record = value => value !== null && typeof value === \"object\" && !Array.isArray(value);\nif (!record(body)) throw new Error(\"Solicitud de prórroga no válida\");\nif (body.args !== undefined && (!record(body.args) || Object.keys(body).some(key => key !== \"args\"))) throw new Error(\"Solicitud de prórroga no válida\");\nconst data = body.args === undefined ? body : body.args;\nconst keys = [\"accion\", \"cedula\", \"folio\", \"dias\", \"valorCompromiso\", \"fechaCompromiso\", \"motivo\", \"codigo\"];\nif (Object.keys(data).some(key => !keys.includes(key))) throw new Error(\"Campos de prórroga no válidos\");\nlet output;\nif (data.accion === \"consultar\") {\n  if (typeof data.codigo !== \"string\" || !/^PR-[A-F0-9]{16}$/.test(data.codigo)) throw new Error(\"Código de propuesta no válido\");\n  output = { accion: \"consultar\", codigo: data.codigo };\n} else if (data.accion === \"proponer\") {\n  const numeric = (value, pattern) => typeof value === \"number\" ? value : typeof value === \"string\" && pattern.test(value) ? Number(value) : NaN;\n  const dias = numeric(data.dias, /^[1-4]$/);\n  const amount = numeric(data.valorCompromiso, /^\\d{1,13}(?:\\.\\d{1,2})?$/);\n  if (![1, 2, 3, 4].includes(dias) || !Number.isFinite(amount) || amount <= 0 || amount > 1e12 || Math.round(amount * 100) / 100 !== amount) throw new Error(\"Días o importe no válidos\");\n  if (![\"cedula\", \"folio\", \"fechaCompromiso\", \"motivo\"].every(key => typeof data[key] === \"string\")) throw new Error(\"Faltan los datos de la propuesta\");\n  output = { accion: \"proponer\", cedula: data.cedula, folio: data.folio, dias,\n    valorCompromiso: amount, fechaCompromiso: data.fechaCompromiso, motivo: data.motivo };\n} else throw new Error(\"Acción de prórroga no válida\");\nmodule.exports = { request_body: JSON.stringify(output) };"
        }
      },
      "parentRefs": [
        "prIn"
      ],
      "childRef": "qryPr",
      "childRefs": [
        "qryPr"
      ],
      "x": 400,
