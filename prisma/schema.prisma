generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  usuarios    Usuario[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Aliado {
  id                              Int                                @id @default(autoincrement())
  nombre                          String                             @unique
  codigo                          String?                            @unique
  activo                          Boolean                            @default(true)
  redescuentoPorcentaje           Float                              @default(10)
  redescuentoAndroidPorcentaje    Float                              @default(10)
  redescuentoIphonePorcentaje     Float                              @default(10)
  dataCreditoPolicyId             String                             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  dataCreditoPolicy               DataCreditoPolicyProfile           @relation(fields: [dataCreditoPolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dataCreditoPolicyAssignmentLogs DataCreditoPolicyAssignmentAudit[]
  liquidacionesAliado             LiquidacionAliado[]
  sedes                           Sede[]
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt

  @@index([activo])
  @@index([dataCreditoPolicyId])
}

model DataCreditoPolicyProfile {
  id                     String                             @id @db.Uuid
  name                   String                             @db.VarChar(80)
  description            String?                            @db.VarChar(240)
  active                 Boolean                            @default(true)
  createdByUserId        Int?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  revisions              DataCreditoPolicyRevision[]
  allies                 Aliado[]
  previousAssignmentLogs DataCreditoPolicyAssignmentAudit[] @relation("DataCreditoPolicyAssignmentPrevious")
  assignmentLogs         DataCreditoPolicyAssignmentAudit[] @relation("DataCreditoPolicyAssignmentCurrent")

  @@index([active, name])
}

model DataCreditoPolicyRevision {
  id              String                   @id @default(uuid()) @db.Uuid
  profileId       String                   @db.Uuid
  version         Int
  policy          Json
  createdByUserId Int
  createdAt       DateTime                 @default(now())
  profile         DataCreditoPolicyProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

model DataCreditoPolicyAssignmentAudit {
  id               String                   @id @default(uuid()) @db.Uuid
  allyId           Int
  previousPolicyId String                   @db.Uuid
  policyId         String                   @db.Uuid
  actorUserId      Int
  createdAt        DateTime                 @default(now())
  ally             Aliado                   @relation(fields: [allyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousPolicy   DataCreditoPolicyProfile @relation("DataCreditoPolicyAssignmentPrevious", fields: [previousPolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  policy           DataCreditoPolicyProfile @relation("DataCreditoPolicyAssignmentCurrent", fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([allyId, createdAt])
  @@index([policyId, createdAt])
}

model Sede {
  id                       Int                     @id @default(autoincrement())
  nombre                   String
  codigo                   String?
  aliadoId                 Int?
  activa                   Boolean                 @default(true)
  clavePanelFinancieroHash String?
  aliado                   Aliado?                 @relation(fields: [aliadoId], references: [id])
  usuarios                 Usuario[]
  vendedoresAsignados      SedeVendedor[]
  creditos                 Credito[]
  creditoAbonos            CreditoAbono[]
  inventario               Inventario[]
  ventas                   Venta[]
  inventariosSede          InventarioSede[]
  cajaMovimientos          CajaMovimiento[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  movimientoCajaSedes      MovimientoCajaSede[]
  abonosFinancieros        AbonoFinanciero[]
  gastosCartera            GastoCartera[]
  arqueosDiarios           ArqueoDiario[]
  capturasCredito          CapturaCreditoSession[]

  @@unique([aliadoId, nombre])
  @@unique([aliadoId, codigo])
  @@index([aliadoId])
}

model Usuario {
  id              Int                     @id @default(autoincrement())
  nombre          String
  usuario         String                  @unique
  claveHash       String
  avatarKey       String?
  activo          Boolean                 @default(true)
  rolId           Int
  sedeId          Int
  rol             Rol                     @relation(fields: [rolId], references: [id])
  sede            Sede                    @relation(fields: [sedeId], references: [id])
  creditos        Credito[]
  creditoAbonos   CreditoAbono[]
  capturasCredito CapturaCreditoSession[]
  ventas          Venta[]
  arqueosDiarios  ArqueoDiario[]
  liquidacionesAliadoRegistradas LiquidacionAliado[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model Vendedor {
  id              Int                     @id @default(autoincrement())
  nombre          String
  documento       String?                 @unique
  telefono        String?
  email           String?
  tipoPerfil      String                  @default("VENDEDOR")
  avatarKey       String?
  activo          Boolean                 @default(true)
  pinHash         String
  pinTemporalHash String?
  debeCambiarPin  Boolean                 @default(true)
  ultimoIngresoAt DateTime?
  asignaciones    SedeVendedor[]
  creditos        Credito[]
  creditoAbonos   CreditoAbono[]
  capturasCredito CapturaCreditoSession[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model SedeVendedor {
  sedeId     Int
  vendedorId Int
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sede     Sede     @relation(fields: [sedeId], references: [id])
  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@id([sedeId, vendedorId])
  @@index([vendedorId])
  @@index([sedeId, activo])
}

model CapturaCreditoSession {
  id                        Int       @id @default(autoincrement())
  token                     String    @unique
  estado                    String    @default("ABIERTA")
  expiresAt                 DateTime
  usuarioId                 Int
  vendedorId                Int?
  sedeId                    Int
  clienteNombre             String?
  clienteDocumento          String?
  clienteTelefono           String?
  selfieDataUrl             String?
  selfieCapturedAt          DateTime?
  selfieSource              String?
  cedulaFrenteDataUrl       String?
  cedulaFrenteCapturedAt    DateTime?
  cedulaFrenteSource        String?
  cedulaRespaldoDataUrl     String?
  cedulaRespaldoCapturedAt  DateTime?
  cedulaRespaldoSource      String?
  videoAprobacionDataUrl    String?
  videoAprobacionCapturedAt DateTime?
  videoAprobacionSource     String?
  videoAprobacionDuration   Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  usuario  Usuario   @relation(fields: [usuarioId], references: [id])
  vendedor Vendedor? @relation(fields: [vendedorId], references: [id])
  sede     Sede      @relation(fields: [sedeId], references: [id])

  @@index([usuarioId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([sedeId, createdAt])
  @@index([expiresAt])
}

model Credito {
  id                            Int                  @id @default(autoincrement())
  folio                         String               @unique
  clienteNombre                 String
  clientePrimerNombre           String?
  clientePrimerApellido         String?
  clienteTipoDocumento          String?
  clienteDocumento              String?
  clienteTelefono               String?
  clienteCorreo                 String?
  clienteDireccion              String?
  clienteDepartamento           String?
  clienteCiudad                 String?
  clienteGenero                 String?
  clienteFechaNacimiento        DateTime?
  clienteFechaExpedicion        DateTime?
  imei                          String
  deviceUid                     String
  referenciaEquipo              String?
  equipoMarca                   String?
  equipoModelo                  String?
  valorEquipoTotal              Float                @default(0)
  saldoBaseFinanciado           Float                @default(0)
  montoCredito                  Float
  cuotaInicial                  Float                @default(0)
  plazoMeses                    Int?
  frecuenciaPago                String               @default("QUINCENAL")
  tasaInteresEa                 Float                @default(0)
  valorInteres                  Float                @default(0)
  fianzaPorcentaje              Float                @default(0)
  valorFianza                   Float                @default(0)
  valorCuota                    Float                @default(0)
  fechaCredito                  DateTime             @default(now())
  fechaPrimerPago               DateTime?
  fechaProximoPago              DateTime?
  referenciaPago                String?
  estado                        String               @default("GENERADO")
  deliverableLabel              String?
  deliverableReady              Boolean              @default(false)
  equalityState                 String?
  equalityService               String?
  equalityPayload               Json?
  equalityLastCheckAt           DateTime?
  graceUntil                    DateTime?
  warrantyUntil                 DateTime?
  bloqueoRobo                   Boolean              @default(false)
  bloqueoRoboAt                 DateTime?
  bloqueoMora                   Boolean              @default(false)
  bloqueoMoraAt                 DateTime?
  pazYSalvoEmitidoAt            DateTime?
  observacionAdmin              String?
  contratoAceptadoAt            DateTime?
  pagareAceptadoAt              DateTime?
  contratoIp                    String?
  contratoFirmaDataUrl          String?
  contratoFotoDataUrl           String?
  contratoSelfieDataUrl         String?
  contratoCedulaFrenteDataUrl   String?
  contratoCedulaRespaldoDataUrl String?
  iphoneSelfieCedulaDataUrl     String?
  fotoEntregaDataUrl            String?
  fotoRemisionDataUrl           String?
  contratoOtpCanal              String?
  contratoOtpDestino            String?
  contratoOtpVerificadoAt       DateTime?
  contratoSnapshot              Json?
  usuarioId                     Int
  vendedorId                    Int?
  sedeId                        Int
  usuario                       Usuario              @relation(fields: [usuarioId], references: [id])
  vendedor                      Vendedor?            @relation(fields: [vendedorId], references: [id])
  sede                          Sede                 @relation(fields: [sedeId], references: [id])
  abonos                        CreditoAbono[]
  amortizacion                  CreditoAmortizacion?
  wompiPaymentIntents           WompiPaymentIntent[]
  liquidacionAliadoCredito      LiquidacionAliadoCredito?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt

  @@index([usuarioId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([sedeId, createdAt])
  @@index([deviceUid])
  @@index([imei])
}

model LiquidacionAliado {
  id                          Int                         @id @default(autoincrement())
  mutationId                  String                      @unique @db.Uuid
  requestHash                 String                      @db.Char(64)
  aliadoId                    Int
  periodoInicio               DateTime                    @db.Date
  periodoFin                  DateTime                    @db.Date
  numeroAprobacionBancaria    String                      @db.VarChar(120)
  numeroAprobacionNormalizado String                      @unique @db.VarChar(120)
  estado                      String                      @default("PAGADA") @db.VarChar(16)
  numeroCreditos              Int
  totalValorVenta             Decimal                     @db.Decimal(20, 2)
  totalCreditoAutorizado      Decimal                     @db.Decimal(20, 2)
  totalCuotaInicial           Decimal                     @db.Decimal(20, 2)
  totalIntermediacion         Decimal                     @db.Decimal(20, 2)
  totalPagar                  Decimal                     @db.Decimal(20, 2)
  registradoPorUsuarioId      Int
  registradoPorNombre         String                      @db.VarChar(160)
  pagadoAt                    DateTime                    @default(now())
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  aliado                      Aliado                      @relation(fields: [aliadoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registradoPor               Usuario                     @relation(fields: [registradoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creditos                    LiquidacionAliadoCredito[]

  @@index([aliadoId, pagadoAt])
  @@index([periodoInicio, periodoFin])
  @@index([estado, pagadoAt])
  @@index([registradoPorUsuarioId, pagadoAt])
}

model LiquidacionAliadoCredito {
  id                       Int                @id @default(autoincrement())
  liquidacionId            Int
  creditoId                Int                @unique
  fechaCredito             DateTime
  folio                    String             @db.VarChar(80)
  clienteNombre            String             @db.VarChar(180)
  clienteDocumento         String             @db.VarChar(80)
  imei                     String             @db.VarChar(80)
  equipo                   String             @db.VarChar(240)
  plataforma               String             @db.VarChar(16)
  valorVenta               Decimal            @db.Decimal(20, 2)
  creditoAutorizado        Decimal            @db.Decimal(20, 2)
  cuotaInicial             Decimal            @db.Decimal(20, 2)
  porcentajeIntermediacion Decimal            @db.Decimal(7, 4)
  valorIntermediacion      Decimal            @db.Decimal(20, 2)
  valorPagar               Decimal            @db.Decimal(20, 2)
  estado                   String             @default("PAGADO") @db.VarChar(16)
  createdAt                DateTime           @default(now())
  liquidacion              LiquidacionAliado @relation(fields: [liquidacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credito                  Credito            @relation(fields: [creditoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([liquidacionId, plataforma])
  @@index([plataforma, fechaCredito])
  @@index([estado, createdAt])
}

model CreditoAbono {
  id                  Int       @id @default(autoincrement())
  creditoId           Int
  usuarioId           Int
  vendedorId          Int?
  sedeId              Int
  valor               Float
  metodoPago          String    @default("EFECTIVO")
  observacion         String?
  estado              String    @default("ACTIVO")
  anuladoAt           DateTime?
  anulacionMotivo     String?
  anuladoPorUsuarioId Int?
  fechaAbono          DateTime  @default(now())
  credito             Credito   @relation(fields: [creditoId], references: [id])
  usuario             Usuario   @relation(fields: [usuarioId], references: [id])
  vendedor            Vendedor? @relation(fields: [vendedorId], references: [id])
  sede                Sede      @relation(fields: [sedeId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([creditoId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([sedeId, createdAt])
  @@index([estado, creditoId])
}

model CreditoAmortizacion {
  id                      Int                        @id @default(autoincrement())
  creditoId               Int                        @unique
  calculoVersion          String                     @default("FRANCES_V1")
  frecuenciaPago          String
  periodosPorAnio         Int
  numeroCuotas            Int
  valorVenta              Decimal                    @db.Decimal(20, 6)
  cuotaInicial            Decimal                    @db.Decimal(20, 6)
  valorFinanciado         Decimal                    @db.Decimal(20, 6)
  tasaInteresEaPorcentaje Decimal                    @db.Decimal(18, 12)
  tasaPeriodo             Decimal                    @db.Decimal(18, 12)
  fianzaCuotaPorcentaje   Decimal                    @db.Decimal(18, 12)
  seguroCuotaPorcentaje   Decimal                    @db.Decimal(18, 12)
  cuotaCreditoExacta      Decimal                    @db.Decimal(20, 6)
  cuotaFianzaExacta       Decimal                    @db.Decimal(20, 6)
  cuotaSeguroExacta       Decimal                    @db.Decimal(20, 6)
  cuotaTotalExacta        Decimal                    @db.Decimal(20, 6)
  cuotaComercial          Decimal                    @db.Decimal(20, 2)
  totalInteres            Decimal                    @db.Decimal(20, 6)
  totalFianza             Decimal                    @db.Decimal(20, 6)
  totalSeguro             Decimal                    @db.Decimal(20, 6)
  totalPagar              Decimal                    @db.Decimal(20, 6)
  parametrosSnapshot      Json
  checksum                String
  aprobadoAt              DateTime                   @default(now())
  createdAt               DateTime                   @default(now())
  credito                 Credito                    @relation(fields: [creditoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cuotas                  CreditoAmortizacionCuota[]

  @@index([checksum])
  @@index([createdAt])
}

model CreditoAmortizacionCuota {
  id               Int                 @id @default(autoincrement())
  amortizacionId   Int
  numero           Int
  fechaVencimiento DateTime            @db.Date
  saldoInicial     Decimal             @db.Decimal(20, 6)
  interes          Decimal             @db.Decimal(20, 6)
  abonoCapital     Decimal             @db.Decimal(20, 6)
  fianza           Decimal             @db.Decimal(20, 6)
  seguro           Decimal             @db.Decimal(20, 6)
  cuotaCredito     Decimal             @db.Decimal(20, 6)
  cuotaTotal       Decimal             @db.Decimal(20, 6)
  cuotaCobro       Decimal             @db.Decimal(20, 2)
  saldoFinal       Decimal             @db.Decimal(20, 6)
  createdAt        DateTime            @default(now())
  amortizacion     CreditoAmortizacion @relation(fields: [amortizacionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([amortizacionId, numero])
  @@index([fechaVencimiento])
}

model ExcepcionBloqueoMora {
  id                 Int       @id @default(autoincrement())
  documento          String    @unique
  motivo             String
  activa             Boolean   @default(true)
  fechaFin           DateTime?
  creadoPorUsuarioId Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([activa, fechaFin])
}

model EfectyRecaudoImport {
  id               Int       @id @default(autoincrement())
  sourceFile       String
  lineNumber       Int
  paymentKey       String    @unique
  lineType         String?
  referencia       String?
  clienteDocumento String?
  empresa          String?
  valor            Float     @default(0)
  fechaPago        DateTime?
  status           String    @default("PENDIENTE")
  message          String?
  creditoId        Int?
  abonoId          Int?
  rawLine          String
  payload          Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceFile, lineNumber])
  @@index([clienteDocumento])
  @@index([referencia])
  @@index([status, createdAt])
}

model WompiPaymentIntent {
  id                Int       @id @default(autoincrement())
  reference         String    @unique
  creditoId         Int
  credito           Credito   @relation(fields: [creditoId], references: [id])
  cuotaNumeros      Json
  amount            Float
  amountInCents     Int
  currency          String    @default("COP")
  status            String    @default("PENDING")
  transactionId     String?   @unique
  paymentMethodType String?
  customerEmail     String?
  customerDocument  String?
  processedAbonoId  Int?
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creditoId, createdAt])
  @@index([status, createdAt])
}

model Inventario {
  id               Int       @id @default(autoincrement())
  fechaIngreso     DateTime
  distribuidor     String?
  referencia       String
  color            String?
  imei             String    @unique
  deboA            String?
  vendidoEn        String?
  asesor           String?
  estadoActual     String
  costo            Decimal?  @db.Decimal(12, 2)
  estadoAnterior   String?
  fechaMovimiento  DateTime?
  origenMovimiento String?
  observacion      String?
  sedeActualId     Int
  sedeActual       Sede      @relation(fields: [sedeActualId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Venta {
  id                 Int      @id @default(autoincrement())
  idVenta            String   @unique
  fecha              DateTime
  hora               String?
  servicio           String
  descripcion        String?
  serial             String
  jalador            String?
  ingreso            Decimal? @db.Decimal(12, 2)
  alcanos            Decimal? @db.Decimal(12, 2)
  payjoy             Decimal? @db.Decimal(12, 2)
  sistecredito       Decimal? @db.Decimal(12, 2)
  addi               Decimal? @db.Decimal(12, 2)
  sumaspay           Decimal? @db.Decimal(12, 2)
  celya              Decimal? @db.Decimal(12, 2)
  bogota             Decimal? @db.Decimal(12, 2)
  alocredit          Decimal? @db.Decimal(12, 2)
  esmio              Decimal? @db.Decimal(12, 2)
  kaiowa             Decimal? @db.Decimal(12, 2)
  finser             Decimal? @db.Decimal(12, 2)
  gora               Decimal? @db.Decimal(12, 2)
  financierasDetalle Json?
  utilidad           Decimal? @db.Decimal(12, 2)
  cerrador           String?
  comision           Decimal? @db.Decimal(12, 2)
  salida             Decimal? @db.Decimal(12, 2)
  cajaOficina        Decimal? @db.Decimal(12, 2)
  tipoIngreso        String?
  ingreso1           String?
  ingreso2           String?
  primerValor        Decimal? @db.Decimal(12, 2)
  segundoValor       Decimal? @db.Decimal(12, 2)

  usuarioId        Int
  sedeId           Int
  inventarioSedeId Int?

  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  sede           Sede            @relation(fields: [sedeId], references: [id])
  inventarioSede InventarioSede? @relation(fields: [inventarioSedeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogoPersonalVenta {
  id                       Int      @id @default(autoincrement())
  tipo                     String
  nombre                   String
  nombreNormalizado        String
  aplicaIntermediacion     Boolean  @default(false)
  porcentajeIntermediacion Float    @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tipo, nombreNormalizado])
}

model CatalogoEquipoModelo {
  id                Int      @id @default(autoincrement())
  marca             String
  marcaNormalizada  String
  modelo            String
  modeloNormalizado String
  precioBaseVenta   Float
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([marcaNormalizada, modeloNormalizado])
  @@index([activo, marcaNormalizada])
}

model CreditoConfiguracion {
  id                           Int      @id @default(autoincrement())
  nombre                       String   @unique
  calculoVersion               String?  @default("ARES_FRANCES_V1")
  tasaInteresEa                Float    @default(29.66)
  fianzaPorcentaje             Float    @default(75)
  fianzaTotalPorcentaje        Float?   @default(75)
  fianzaCuotaPorcentaje        Float    @default(2.083333)
  seguroCuotaPorcentaje        Float    @default(0.03)
  tasaPeriodoDecimales         Int?     @default(6)
  redondeoComercialModo        String?  @default("PISO")
  redondeoComercialMultiplo    Int?     @default(50)
  cuotaInicialPorcentaje       Float    @default(20)
  plazoCuotas                  Int      @default(12)
  plazoMaximoCuotas            Int      @default(16)
  iphoneCuotaInicialPorcentaje Float    @default(30)
  iphonePlazoCuotas            Int      @default(24)
  iphonePlazoMaximoCuotas      Int      @default(48)
  iphoneTopeFinanciado         Int      @default(3500000)
  iphoneTopeCuota              Int      @default(160000)
  frecuenciaPago               String   @default("QUINCENAL")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model CreditoConfiguracionDocumento {
  id                            Int      @id @default(autoincrement())
  documento                     String
  documentoNormalizado          String   @unique
  calculoVersion                String?
  tasaInteresEa                 Float?
  fianzaPorcentaje              Float?
  fianzaTotalPorcentaje         Float?
  fianzaCuotaPorcentaje         Float?
  seguroCuotaPorcentaje         Float?
  tasaPeriodoDecimales          Int?
  redondeoComercialModo         String?
  redondeoComercialMultiplo     Int?
  cuotaInicialPorcentaje        Float?
  plazoCuotas                   Int?
  plazoMaximoCuotas             Int?
  frecuenciaPago                String?
  permiteMultiplesCreditos      Boolean  @default(false)
  permiteEntregaSinVerificacion Boolean  @default(false)
  activo                        Boolean  @default(true)
  observacion                   String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([activo])
}

model InventarioPrincipal {
  id            Int     @id @default(autoincrement())
  imei          String  @unique
  referencia    String
  color         String?
  costo         Float
  numeroFactura String?
  distribuidor  String?

  // NUEVO: control interno bodega -> sede
  estado        String    @default("BODEGA")
  sedeDestinoId Int?
  estadoCobro   String? // PENDIENTE / PAGADO / CANCELADO
  fechaEnvio    DateTime?
  observacion   String?

  inventariosSede InventarioSede[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventarioSede {
  id           Int     @id @default(autoincrement())
  imei         String
  referencia   String
  color        String?
  costo        Float
  distribuidor String?

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id])

  deboA            String?
  estadoFinanciero String
  origen           String

  inventarioPrincipalId Int?
  inventarioPrincipal   InventarioPrincipal? @relation(fields: [inventarioPrincipalId], references: [id])
  ventas                Venta[]
  estadoActual          String               @default("BODEGA")
  estadoAnterior        String?
  fechaMovimiento       DateTime?
  observacion           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model PrestamoSede {
  id                  Int       @id @default(autoincrement())
  imei                String
  referencia          String
  color               String?
  costo               Float
  sedeOrigenId        Int
  sedeDestinoId       Int
  estado              String    @default("PENDIENTE")
  montoPago           Float?
  fechaSolicitudPago  DateTime?
  fechaAprobacionPago DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  movimientosCaja MovimientoCajaSede[]
}

model MovimientoInventario {
  id               Int     @id @default(autoincrement())
  imei             String
  tipoMovimiento   String
  referencia       String?
  color            String?
  costo            Float?
  sedeId           Int?
  deboA            String?
  estadoFinanciero String?
  origen           String?
  observacion      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CajaMovimiento {
  id          Int      @id @default(autoincrement())
  tipo        String
  concepto    String
  valor       Float
  descripcion String?
  sedeId      Int
  sede        Sede     @relation(fields: [sedeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MovimientoCajaSede {
  id         Int      @id @default(autoincrement())
  sedeId     Int
  tipo       String
  concepto   String
  valor      Float
  prestamoId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sede     Sede          @relation(fields: [sedeId], references: [id])
  prestamo PrestamoSede? @relation(fields: [prestamoId], references: [id])
}

model AbonoFinanciero {
  id          Int      @id @default(autoincrement())
  tipo        String
  entidad     String?
  valor       Float
  observacion String?
  sedeId      Int
  sede        Sede     @relation(fields: [sedeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GastoCartera {
  id          Int      @id @default(autoincrement())
  valor       Float
  observacion String?
  sedeId      Int
  sede        Sede     @relation(fields: [sedeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArqueoDiario {
  id             Int      @id @default(autoincrement())
  sedeId         Int
  usuarioId      Int
  fechaCorte     DateTime
  billetes100000 Int      @default(0)
  billetes50000  Int      @default(0)
  billetes20000  Int      @default(0)
  billetes10000  Int      @default(0)
  billetes5000   Int      @default(0)
  billetes2000   Int      @default(0)
  billetes1000   Int      @default(0)
  monedas500     Int      @default(0)
  monedas200     Int      @default(0)
  monedas100     Int      @default(0)
  monedas50      Int      @default(0)
  voucher        Float    @default(0)
  cheques        Float    @default(0)
  totalContado   Float
  cajaSistema    Float
  diferencia     Float
  estado         String
  observacion    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sede    Sede    @relation(fields: [sedeId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([sedeId, fechaCorte])
}
